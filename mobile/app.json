{
  "expo": {
    "name": "TarkApp",
    "slug": "tarkapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12161A",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "ee.tarkapp.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите TarkApp доступ к фотографиям для разбора учебных материалов.",
          "cameraPermission": "Разрешите TarkApp доступ к камере для съемки страниц учебников."
        }
      ],
      "./plugins/withCleartextTraffic.js"
    ],
    "extra": {
      "eas": {
        "projectId": "1adf92e6-8adb-42c1-8bb6-13e4e63f861e"
      }
    }
  }
}
