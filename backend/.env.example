# TarkApp Backend Environment Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_NAME=gemini-3.8-flash
APP_ENV=development
PORT=8080
HOST=0.0.0.0
CORS_ORIGINS=["*"]

# Security, Auth & Trial Policy
SECRET_KEY="replace_with_strong_random_hmac_secret_64_chars"
ADMIN_SECRET="replace_with_strong_admin_invoice_confirm_secret"
TRIAL_MODE="closed_beta"                  # "closed_beta" (14d, 20/day) or "standard" (5 lifetime reviews)

# Billing & Bank Requisites (Estonia / SEPA)
COMPANY_NAME="Tark Systems OÜ"
COMPANY_REG="17000000"
BANK_NAME="Coop Pank AS"
BANK_IBAN=""                              # Укажите реальный расчётный счёт IBAN
BANK_SWIFT="CPNKEE2X"

# Azure Speech Service
AZURE_SPEECH_KEY="your_azure_speech_key"
AZURE_SPEECH_REGION="northeurope"

# Telegram Alerting & Topic Routing (Optional)
TELEGRAM_BOT_TOKEN="твой_токен_бота"
TELEGRAM_CHAT_ID="-100xxxxxxxxxx"         # ID супергруппы
TELEGRAM_TOPIC_BUGS="12"                  # ID топика "Жалобы и баги"
TELEGRAM_TOPIC_FEATURES="14"              # ID топика "Идеи и пожелания"
TELEGRAM_TOPIC_ALERTS="16"                # ID топика "Критические аварии"
TELEGRAM_TOPIC_INVOICES="9"               # ID топика "Счета и инвойсы"
ADMIN_TELEGRAM_ID="123456789"             # ID администратора в Telegram для команд /gen и /stats
TELEGRAM_WEBHOOK_SECRET="your_webhook_secret_token" # Секретный токен заголовка X-Telegram-Bot-Api-Secret-Token

# Почтовый транспорт для отправки PDF-счетов (SMTP или Resend API)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_app_password"
SMTP_FROM="TarkApp <your_email@gmail.com>"
SMTP_USE_TLS=true

RESEND_API_KEY=""
RESEND_FROM="TarkApp <onboarding@resend.dev>"

# CORS Origins (через запятую или JSON-массив)
CORS_ORIGINS="https://tarkapp.ee,https://www.tarkapp.ee,https://app.tarkapp.ee,http://localhost:8081"


