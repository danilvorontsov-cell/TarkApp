# TarkApp Backend Environment Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
APP_ENV=development
PORT=8080
HOST=0.0.0.0
CORS_ORIGINS=["*"]

# Telegram Alerting & Topic Routing (Optional)
TELEGRAM_BOT_TOKEN="твой_токен_бота"
TELEGRAM_CHAT_ID="-100xxxxxxxxxx"         # ID супергруппы
TELEGRAM_TOPIC_BUGS="12"                  # ID топика "Жалобы и баги"
TELEGRAM_TOPIC_FEATURES="14"              # ID топика "Идеи и пожелания"
TELEGRAM_TOPIC_ALERTS="16"                # ID топика "Критические аварии"
ADMIN_TELEGRAM_ID="123456789"             # ID администратора в Telegram для команд /gen и /stats
TELEGRAM_WEBHOOK_SECRET="your_webhook_secret_token" # Секретный токен заголовка X-Telegram-Bot-Api-Secret-Token

